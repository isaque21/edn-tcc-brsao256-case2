{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectsInDocumentsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_DOCUMENTOS>/*"
    },
    {
      "Sid": "ListDocumentsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_DOCUMENTOS>"
    },
    {
      "Sid": "KmsOnlyThroughS3",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "<KMS_KEY_ARN>",
      "Condition": {
        "StringEquals": { "kms:ViaService": "s3.<REGIAO>.amazonaws.com" }
      }
    }
  ]
}
